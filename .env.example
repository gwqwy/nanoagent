# nanoagent 配置模板
# 复制为 .env 并填入你自己的配置，任何 OpenAI 兼容服务均可：
#   智谱 GLM   base_url=https://open.bigmodel.cn/api/paas/v4/
#   DeepSeek   base_url=https://api.deepseek.com/v1
#   Kimi       base_url=https://api.moonshot.cn/v1
#   通义千问   base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama     base_url=http://localhost:11434/v1

NANOAGENT_BASE_URL=https://api.deepseek.com/v1
NANOAGENT_API_KEY=sk-xxxx
NANOAGENT_MODEL=deepseek-chat
NANOAGENT_EMBEDDING_MODEL=text-embedding-3-small
